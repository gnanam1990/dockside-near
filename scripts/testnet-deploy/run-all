#!/bin/sh
# Dockside escrow: everything after account creation, in one command.
#
#   1. verify the container-built wasm against the build manifest (SHA-256 and NEAR code hash)
#   2. preflight: the named accounts exist, the escrow account is empty and funded for storage
#   3. deploy the wasm and initialise it (`new`) in one transaction, signed by the escrow account
#   4. verify the on-chain code hash and the initialised config
#   5. configure the relayer: a function-call access key restricted to the escrow contract,
#      generated and saved by near-cli-rs, then checked on chain
#   6. run the journey: register, policy, fund (buyer), attest, inspect, intent, approve,
#      execute, and check the supplier received exactly the trade amount
#   7. write the run record
#
# Usage:
#   DOCKSIDE_ESCROW_ACCOUNT=<escrow>.testnet DOCKSIDE_BUYER_ACCOUNT=<buyer>.testnet \
#   DOCKSIDE_SUPPLIER_ACCOUNT=<supplier>.testnet DOCKSIDE_RELAYER_ACCOUNT=<relayer>.testnet \
#     scripts/testnet-deploy/run-all --network testnet|sandbox [options]
#
# Options:
#   --network <testnet|sandbox>  required; nothing else is accepted (mainnet is refused)
#   --rpc-url <url>              default https://rpc.testnet.near.org, or http://127.0.0.1:4521 for sandbox
#   --wasm <file>                default .data/repro/dockside_escrow.wasm (scripts/container-reproduce.sh)
#   --manifest <file>            default .data/repro/build-manifest.json
#   --amount-yocto <n>           journey trade amount, default 50000000000000000000000 (0.05 NEAR)
#   --out <dir>                  default .data/testnet-run/<network>-<UTC time>
#   --skip-deploy                reuse an escrow that already runs the manifest's code
#   --relayer-key-file <file>    reuse a function-call key file near-cli-rs saved earlier
#   --allowance <amount>         allowance of a new relayer key, default '1 NEAR'
# Environment: NEAR_CLI (near-cli-rs binary, default `near`), CARGO (default `cargo`).
#
# Signing: the escrow, buyer and relayer accounts sign with their own keys from the near-cli-rs
# keychain (`sign-with-keychain` checks the OS keychain, then ~/.near-credentials). The relayed
# journey calls are signed with the new function-call key file. This script never reads, prints
# or stores a private key.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
NETWORK=""
RPC_URL=""
WASM="$ROOT/.data/repro/dockside_escrow.wasm"
MANIFEST="$ROOT/.data/repro/build-manifest.json"
AMOUNT_YOCTO="50000000000000000000000"
OUT=""
SKIP_DEPLOY=""
KEY_FILE=""
ALLOWANCE="1 NEAR"
NEAR_BIN="${NEAR_CLI:-near}"
CARGO_BIN="${CARGO:-cargo}"

usage() {
  sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --network) NETWORK="${2:-}"; shift 2 ;;
    --rpc-url) RPC_URL="${2:-}"; shift 2 ;;
    --wasm) WASM="${2:-}"; shift 2 ;;
    --manifest) MANIFEST="${2:-}"; shift 2 ;;
    --amount-yocto) AMOUNT_YOCTO="${2:-}"; shift 2 ;;
    --out) OUT="${2:-}"; shift 2 ;;
    --skip-deploy) SKIP_DEPLOY=1; shift ;;
    --relayer-key-file) KEY_FILE="${2:-}"; shift 2 ;;
    --allowance) ALLOWANCE="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "run-all: unknown argument $1" >&2; usage ;;
  esac
done

TOOL="$ROOT/scripts/testnet-deploy/tool.mjs"
say() { echo "run-all: $*" >&2; }
net_flags() {
  if [ -n "$RPC_URL" ]; then echo "--network $NETWORK --rpc-url $RPC_URL"; else echo "--network $NETWORK"; fi
}

command -v node >/dev/null 2>&1 || { say "node is required"; exit 2; }
# Refuses anything but testnet or a loopback sandbox before any other step.
CLI_NETWORK=$(node "$TOOL" profile $(net_flags) --field cliNetwork)
RPC=$(node "$TOOL" profile $(net_flags) --field rpcUrl)
RPC_URL="$RPC"
node "$TOOL" accounts >/dev/null
command -v "$NEAR_BIN" >/dev/null 2>&1 || { say "near-cli-rs ($NEAR_BIN) is required; set NEAR_CLI"; exit 2; }
command -v "$CARGO_BIN" >/dev/null 2>&1 || { say "cargo is required to build the journey payload builder"; exit 2; }

if [ -z "$OUT" ]; then OUT="$ROOT/.data/testnet-run/$NETWORK-$(date -u +%Y%m%dT%H%M%SZ)"; fi
mkdir -p "$OUT"
say "network $NETWORK ($RPC), near-cli-rs connection '$CLI_NETWORK', record in $OUT"

say "1/7 verify the wasm against the build manifest"
node "$TOOL" verify-artifact --wasm "$WASM" --manifest "$MANIFEST" >"$OUT/artifact.json"
CODE_HASH=$(node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).nearCodeHash)' "$OUT/artifact.json")
say "    code hash $CODE_HASH"

say "2/7 preflight"
if [ -n "$SKIP_DEPLOY" ]; then
  node "$TOOL" preflight $(net_flags) --wasm "$WASM" --amount-yocto "$AMOUNT_YOCTO" --skip-deploy >"$OUT/preflight.json"
else
  node "$TOOL" preflight $(net_flags) --wasm "$WASM" --amount-yocto "$AMOUNT_YOCTO" >"$OUT/preflight.json"
fi

say "    building the journey payload builder"
"$CARGO_BIN" build --quiet --locked --release --manifest-path "$ROOT/contract/integration/Cargo.toml" \
  -p dockside-fixtures --bin dockside-journey-mirror
MIRROR="$ROOT/contract/integration/target/release/dockside-journey-mirror"
[ -x "$MIRROR" ] || MIRROR="$MIRROR.exe"

ESCROW="$DOCKSIDE_ESCROW_ACCOUNT"
RELAYER="$DOCKSIDE_RELAYER_ACCOUNT"
if [ -z "$SKIP_DEPLOY" ]; then
  say "3/7 deploy and initialise $ESCROW in one transaction"
  # One transaction: nobody can initialise the contract between the deploy and `new`.
  if ! "$NEAR_BIN" contract deploy "$ESCROW" use-file "$WASM" \
      with-init-call new json-args '{"network":"near-testnet","min_deposit_yocto":null}' \
      prepaid-gas '30.0 Tgas' attached-deposit '0 NEAR' \
      network-config "$CLI_NETWORK" sign-with-keychain send >"$OUT/deploy.txt" 2>&1; then
    say "deploy failed; near-cli-rs output in $OUT/deploy.txt"
    exit 1
  fi
  node "$TOOL" tx-hash --file "$OUT/deploy.txt" >"$OUT/deploy-tx.txt"
  say "    transaction $(cat "$OUT/deploy-tx.txt")"
else
  say "3/7 deploy skipped (--skip-deploy)"
fi

say "4/7 verify the on-chain code hash and config"
node "$TOOL" verify-deployment $(net_flags) --code-hash "$CODE_HASH" >"$OUT/deployment.json"

if [ -z "$KEY_FILE" ]; then
  say "5/7 add a function-call key for $RELAYER restricted to $ESCROW"
  if ! "$NEAR_BIN" account add-key "$RELAYER" grant-function-call-access --allowance "$ALLOWANCE" \
      --contract-account-id "$ESCROW" --function-names '' \
      autogenerate-new-keypair save-to-legacy-keychain \
      network-config "$CLI_NETWORK" sign-with-keychain send >"$OUT/relayer-key.txt" 2>&1; then
    say "adding the relayer key failed; near-cli-rs output in $OUT/relayer-key.txt"
    exit 1
  fi
  KEY_FILE=$(node "$TOOL" relayer-key-file --file "$OUT/relayer-key.txt")
else
  say "5/7 reuse relayer key file $KEY_FILE"
fi
node "$TOOL" verify-relayer-key $(net_flags) --key-file "$KEY_FILE" >"$OUT/relayer.json"

say "6/7 journey"
node "$TOOL" journey $(net_flags) --near "$NEAR_BIN" --key-file "$KEY_FILE" --mirror "$MIRROR" \
  --out "$OUT" --amount-yocto "$AMOUNT_YOCTO" >"$OUT/journey-checks.json"

say "7/7 run record"
COMMIT=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)
node -e '
const fs = require("fs");
const [out, commit, network] = process.argv.slice(1);
const read = (f) => JSON.parse(fs.readFileSync(`${out}/${f}`, "utf8"));
const tx = fs.existsSync(`${out}/deploy-tx.txt`) ? fs.readFileSync(`${out}/deploy-tx.txt`, "utf8").trim() : null;
const j = read("journey.json");
const rec = {
  schema: "dockside/testnet-run@1", network, scriptCommit: commit, artifact: read("artifact.json"),
  deployTx: tx, deployment: read("deployment.json"), relayer: read("relayer.json"),
  journey: { ok: j.ok, tradeId: j.tradeId, releaseIntentId: j.releaseIntentId, checks: j.checks,
    transactions: j.steps.map((s) => ({ method: s.method, signer: s.signer, txHash: s.txHash })) },
};
fs.writeFileSync(`${out}/run-record.json`, JSON.stringify(rec, null, 2) + "\n");
' "$OUT" "$COMMIT" "$NETWORK"
say "PASS: deployed code hash $CODE_HASH, journey PAID; record $OUT/run-record.json"
