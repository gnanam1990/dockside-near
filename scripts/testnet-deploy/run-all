#!/bin/sh
# Dockside escrow: everything after account creation, in one command.
#
#   1. verify the container-built wasm against the build manifest (SHA-256 and NEAR code hash)
#   2. preflight: the named accounts exist, the escrow account is empty and funded for storage
#   3. deploy the wasm and initialise it (`new`) in one transaction, signed by the escrow account
#   4. verify the on-chain code hash and the initialised config
#   5. configure the relayer: a function-call access key restricted to the escrow contract,
#      generated and saved by near-cli-rs, then checked on chain
#   6. run the journey (--journey, default paid):
#        paid    register, policy, fund (buyer), attest, inspect, intent, approve, execute, and
#                check the supplier received exactly the trade amount
#        hold    as paid, with a deterministic-policy hold SET after the inspection (release
#                blocked: HOLD_ACTIVE) and RESOLVED (RELEASE_HOLD) by the risk/policy principal
#                before the approval, then PAID
#        refund  register, fund the trade amount plus an excess (buyer), MUTUAL_CANCEL (buyer and
#                supplier sign) and EXCESS_FUNDING_RETURN (the buyer's own account) requests, the
#                one-hour cooling period on chain time, authorize and execute both: REFUNDED, the
#                buyer gets back exactly what it deposited and the supplier nothing
#   7. write the run record
#
# Assets (M50). The journeys run in native NEAR (default) or in a NEP-141 token:
#   --asset usdc --token <account>   the trade is funded by the buyer's own ft_transfer_call on the
#                                token contract, released and refunded by the escrow's ft_transfer,
#                                and checked against token balances. Before the journey run-all
#                                registers the escrow (and, for a release, the supplier) with the
#                                token (NEP-145 storage_deposit, paid in NEAR by the escrow account),
#                                and the journey confirms the supplier's registration on chain
#                                (check_payee_storage) before the value is locked. The buyer must
#                                already hold the tokens. A deployment made with --token accepts
#                                that token only.
#
# Real funds (M50). `--network mainnet` runs only with --i-understand-real-funds. A mainnet
# contract is always initialised with non-zero per-trade caps (default 5 NEAR and 25 USDC in base
# units) and, for --asset usdc, with the one token it accepts. Before anything is sent the
# preflight checks the chain id, the caps and the exposure of this run (trade amount plus refund
# excess, against the contract cap and against run-all's own ceiling) and prints the value plan:
# every amount, who sends it and who can receive it. --dry-run stops there.
#
# Usage:
#   DOCKSIDE_ESCROW_ACCOUNT=<escrow>.testnet DOCKSIDE_BUYER_ACCOUNT=<buyer>.testnet \
#   DOCKSIDE_SUPPLIER_ACCOUNT=<supplier>.testnet DOCKSIDE_RELAYER_ACCOUNT=<relayer>.testnet \
#     scripts/testnet-deploy/run-all --network testnet|sandbox|mainnet [options]
#   (same four variables) scripts/testnet-deploy/run-all --resume <run dir> [resume options]
#
# Options:
#   --network <testnet|sandbox|mainnet>  required; mainnet needs --i-understand-real-funds and
#                                accounts that are not .testnet names
#   --i-understand-real-funds    this run may move real funds (mainnet, or the near-mainnet contract
#                                label on a sandbox); must be given again with --resume
#   --contract-network <label>   sandbox only: near-testnet (default) or near-mainnet, to validate
#                                the mainnet path on a local node
#   --dry-run                    stop after the preflight and its value plan; nothing is sent
#   --asset <near|usdc>          the trade asset, default near
#   --token <account>            the NEP-141 contract (required with --asset usdc); pinned at deployment
#   --token-decimals <n>         default 6; checked against the token's own metadata
#   --amount-units <n>           --asset usdc: trade amount in token base units, default 5000000 (5 USDC)
#   --excess-units <n>           --asset usdc, refund journey: excess, default 1000000 (1 USDC)
#   --cap-near-yocto <n>         deployment: cap per native trade (mainnet default 5 NEAR; testnet none)
#   --cap-token-units <n>        deployment: cap per token trade (mainnet default 25000000; testnet none)
#   --max-exposure-near-yocto <n>, --max-exposure-token-units <n>
#                                real funds: the highest contract cap run-all accepts (defaults: the
#                                mainnet default caps)
#   --rpc-url <url>              default https://test.rpc.fastnear.com, https://rpc.mainnet.fastnear.com
#                                for mainnet, or http://127.0.0.1:4521 for sandbox
#   --fallback-rpc-urls <a,b>    further RPC URLs for the read-only checks (same rules as --rpc-url)
#   --wasm <file>                default .data/repro/dockside_escrow.wasm (scripts/container-reproduce.sh)
#   --manifest <file>            default .data/repro/build-manifest.json
#   --amount-yocto <n>           --asset near: trade amount, default 50000000000000000000000 (0.05 NEAR)
#   --out <dir>                  default .data/testnet-run/<network>-<UTC time>
#   --skip-deploy                reuse an escrow that already runs the manifest's code
#   --relayer-key-file <file>    reuse a function-call key file near-cli-rs saved earlier
#   --allowance <amount>         allowance of a new relayer key, default '1 NEAR'
#   --journey <paid|hold|refund> the journey step 6 runs, default paid
#   --excess-yocto <n>           refund journey: excess deposited on top of the trade amount,
#                                default 10000000000000000000000 (0.01 NEAR)
#   --no-wait                    refund journey: stop (exit 3) instead of waiting out the cooling period
#   --stop-after <n>             stop (exit 3) once the journey has n transactions on chain
# Resume options:
#   --resume <run dir>           finish an interrupted or paused journey from its run directory. The
#                                network, RPC URL, journey, amount, wasm, manifest and relayer key file
#                                come from <run dir>/run-params.json and the journey's key seed from
#                                <run dir>/journey-seed.json; the deployment and the relayer key are
#                                checked again (read-only), the completed steps are replayed on the
#                                mirror, the chain must agree, and the journey continues
#   --pending-tx <hash|none>     the transaction of a call whose id was lost when the run stopped, or
#                                none if it never reached the escrow (run-all says when it needs this)
#   --rpc-url <url>              use this RPC URL instead of the recorded one (for example when the
#                                recorded endpoint went away); it must pass the same network rules for
#                                the run's recorded network. Nothing else of the run can be overridden
#   --no-wait, --stop-after and --fallback-rpc-urls work as above.
# Environment: NEAR_CLI (near-cli-rs binary; on Windows the real near.exe is found from the npm
# global prefix or `where near`), CARGO (default `cargo`), DOCKSIDE_FALLBACK_RPC_URLS.
#
# Journey keys: the Dockside principal keys of the journey's trade (test keys of that one trade,
# not NEAR keys) derive from a random seed kept in <run dir>/journey-seed.json, mode 0600, so a
# stuck trade can be finished with --resume. No NEAR private key is read, printed or stored.
#
# Exit status: 0 PASS, 1 a near-cli-rs command failed, 2 a refusal or a failed check, 3 PAUSED
# (the journey stopped part way on purpose; finish it with --resume <run dir>).
#
# Every near-cli-rs command runs through `tool.mjs near-run` with stdin closed, so a question it
# asks fails at once instead of hanging; "Transaction has expired" (never included) is signed
# again, at most 3 attempts.
#
# Signing: the escrow, buyer and relayer accounts sign with their own keys from the near-cli-rs
# keychain (`sign-with-keychain` checks the OS keychain, then ~/.near-credentials). The relayed
# journey calls are signed with the new function-call key file. This script never reads, prints
# or stores a private key.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
NETWORK=""
RPC_URL=""
WASM="$ROOT/.data/repro/dockside_escrow.wasm"
MANIFEST="$ROOT/.data/repro/build-manifest.json"
AMOUNT_YOCTO=""
OUT=""
REAL_FUNDS=""
CONTRACT_NETWORK=""
DRY_RUN=""
# Asset, amount and cap flags, passed to tool.mjs as they were given.
ASSET_FLAGS=""
SKIP_DEPLOY=""
KEY_FILE=""
ALLOWANCE="1 NEAR"
CARGO_BIN="${CARGO:-cargo}"
JOURNEY="paid"
EXCESS_YOCTO=""
NO_WAIT=""
STOP_AFTER=""
RESUME=""
PENDING_TX=""
RPC_OVERRIDE=""
# Options a resumed run must not take: the run directory decides them.
FIXED=""

usage() {
  sed -n '2,/^set -eu/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --network) NETWORK="${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    # Not in FIXED: a resumed run may move to another RPC URL (the endpoint, not the network).
    --rpc-url) RPC_URL="${2:-}"; RPC_OVERRIDE=1; shift 2 ;;
    --fallback-rpc-urls) DOCKSIDE_FALLBACK_RPC_URLS="${2:-}"; export DOCKSIDE_FALLBACK_RPC_URLS; shift 2 ;;
    --wasm) WASM="${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    --manifest) MANIFEST="${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    --amount-yocto) AMOUNT_YOCTO="${2:-}"; ASSET_FLAGS="$ASSET_FLAGS $1 ${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    --asset|--token|--token-decimals|--amount-units|--excess-units|--cap-near-yocto|--cap-token-units|--max-exposure-near-yocto|--max-exposure-token-units)
      case "${2:-}" in ""|*[!A-Za-z0-9._-]*) echo "run-all: USAGE: $1 needs a plain value" >&2; exit 2 ;; esac
      ASSET_FLAGS="$ASSET_FLAGS $1 $2"; FIXED="$FIXED $1"; shift 2 ;;
    --i-understand-real-funds) REAL_FUNDS=1; shift ;;
    --contract-network) CONTRACT_NETWORK="${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    --dry-run) DRY_RUN=1; FIXED="$FIXED $1"; shift ;;
    --out) OUT="${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    --skip-deploy) SKIP_DEPLOY=1; FIXED="$FIXED $1"; shift ;;
    --relayer-key-file) KEY_FILE="${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    --allowance) ALLOWANCE="${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    --journey) JOURNEY="${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    --excess-yocto) EXCESS_YOCTO="${2:-}"; ASSET_FLAGS="$ASSET_FLAGS $1 ${2:-}"; FIXED="$FIXED $1"; shift 2 ;;
    --no-wait) NO_WAIT=1; shift ;;
    --stop-after) STOP_AFTER="${2:-}"; shift 2 ;;
    --resume) RESUME="${2:-}"; shift 2 ;;
    --pending-tx) PENDING_TX="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "run-all: unknown argument $1" >&2; usage ;;
  esac
done

TOOL="$ROOT/scripts/testnet-deploy/tool.mjs"
say() { echo "run-all: $*" >&2; }
command -v node >/dev/null 2>&1 || { say "node is required"; exit 2; }

if [ -n "$RESUME" ]; then
  [ -z "$FIXED" ] || { say "USAGE: --resume takes the run's own settings; drop$FIXED"; exit 2; }
  [ -d "$RESUME" ] || { say "NOTHING_TO_RESUME: $RESUME is not a directory"; exit 2; }
  OUT=$(CDPATH= cd -- "$RESUME" && pwd)
  NETWORK=$(node "$TOOL" run-params --dir "$OUT" --field network)
  RECORDED_RPC_URL=$(node "$TOOL" run-params --dir "$OUT" --field rpcUrl)
  if [ -n "$RPC_OVERRIDE" ]; then
    # Only the endpoint may change; it is checked against the run's recorded network.
    RPC_URL=$(node "$TOOL" resume-rpc-url --dir "$OUT" --rpc-url "$RPC_URL")
    say "RPC URL override for the resumed run: $RPC_URL (recorded $RECORDED_RPC_URL)"
  else
    RPC_URL="$RECORDED_RPC_URL"
  fi
  CONTRACT_NETWORK=$(node "$TOOL" run-params --dir "$OUT" --field contractNetwork --default near-testnet)
  if [ "$NETWORK" != "sandbox" ]; then CONTRACT_NETWORK=""; fi
  JOURNEY=$(node "$TOOL" run-params --dir "$OUT" --field journey)
  AMOUNT_YOCTO=$(node "$TOOL" run-params --dir "$OUT" --field amountYocto)
  # The asset of the run, for the read-only checks (the journey itself reads its seed file).
  RESUME_ASSET=$(node "$TOOL" run-params --dir "$OUT" --field asset --default near)
  RESUME_TOKEN=$(node "$TOOL" run-params --dir "$OUT" --field token --default)
  RESUME_DECIMALS=$(node "$TOOL" run-params --dir "$OUT" --field tokenDecimals --default)
  if [ "$RESUME_ASSET" = "usdc" ]; then
    ASSET_FLAGS="--asset usdc --token $RESUME_TOKEN --token-decimals $RESUME_DECIMALS"
  fi
  WASM=$(node "$TOOL" run-params --dir "$OUT" --field wasm)
  MANIFEST=$(node "$TOOL" run-params --dir "$OUT" --field manifest)
  KEY_FILE=$(node "$TOOL" run-params --dir "$OUT" --field relayerKeyFile)
  SKIP_DEPLOY=1
elif [ -n "$PENDING_TX" ]; then
  say "USAGE: --pending-tx needs --resume <run dir>"
  exit 2
fi
case "$JOURNEY" in
  paid|hold|refund) ;;
  *) say "USAGE: --journey must be paid, hold or refund"; exit 2 ;;
esac

net_flags() {
  NF="--network $NETWORK"
  if [ -n "$RPC_URL" ]; then NF="$NF --rpc-url $RPC_URL"; fi
  if [ -n "$CONTRACT_NETWORK" ]; then NF="$NF --contract-network $CONTRACT_NETWORK"; fi
  if [ -n "$REAL_FUNDS" ]; then NF="$NF --i-understand-real-funds"; fi
  echo "$NF"
}

# Before any other step: the network (mainnet and the near-mainnet label only with
# --i-understand-real-funds), the account names for that network, and every asset, amount and cap
# flag. Nothing is read from the chain and nothing is sent here.
CLI_NETWORK=$(node "$TOOL" profile $(net_flags) --field cliNetwork)
RPC=$(node "$TOOL" profile $(net_flags) --field rpcUrl)
RPC_URL="$RPC"
LABEL=$(node "$TOOL" profile $(net_flags) --field contractNetwork)
IS_REAL=$(node "$TOOL" profile $(net_flags) --field realFunds)
node "$TOOL" accounts $(net_flags) >/dev/null
if [ -z "$RESUME" ]; then
  node "$TOOL" check-run $(net_flags) $ASSET_FLAGS --journey "$JOURNEY" >/dev/null
fi
ASSET=$(node "$TOOL" check-run $(net_flags) $ASSET_FLAGS --field asset)
TOKEN=$(node "$TOOL" check-run $(net_flags) $ASSET_FLAGS --field token)
TOKEN_DECIMALS=$(node "$TOOL" check-run $(net_flags) $ASSET_FLAGS --field tokenDecimals)
AMOUNT=$(node "$TOOL" check-run $(net_flags) $ASSET_FLAGS --field amount)
if [ -z "$DRY_RUN" ]; then
  # NEAR_CLI, or on Windows the real near.exe behind npm's near/near.cmd/near.ps1 shims.
  NEAR_BIN=$(node "$TOOL" near-cli </dev/null)
  "$NEAR_BIN" --version </dev/null >/dev/null 2>&1 || { say "near-cli-rs ($NEAR_BIN) does not run; set NEAR_CLI"; exit 2; }
  command -v "$CARGO_BIN" >/dev/null 2>&1 || { say "cargo is required to build the journey payload builder"; exit 2; }
fi

if [ -z "$OUT" ]; then OUT="$ROOT/.data/testnet-run/$NETWORK-$(date -u +%Y%m%dT%H%M%SZ)"; fi
if [ -z "$RESUME" ] && [ -e "$OUT/journey-seed.json" ]; then
  say "RUN_EXISTS: $OUT already holds a journey; finish it with --resume $OUT or choose another --out"
  exit 2
fi
mkdir -p "$OUT"
say "network $NETWORK ($RPC), contract label $LABEL, near-cli-rs connection '$CLI_NETWORK', $JOURNEY journey in $ASSET${TOKEN:+ ($TOKEN)}, record in $OUT"
if [ "$IS_REAL" = "true" ]; then say "REAL FUNDS: this run uses the $LABEL contract label (--i-understand-real-funds was given)"; fi

say "1/7 verify the wasm against the build manifest"
node "$TOOL" verify-artifact --wasm "$WASM" --manifest "$MANIFEST" >"$OUT/artifact.json"
CODE_HASH=$(node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).nearCodeHash)' "$OUT/artifact.json")
say "    code hash $CODE_HASH"

PRE_FLAGS="$ASSET_FLAGS --journey $JOURNEY"
if [ -n "$KEY_FILE" ]; then PRE_FLAGS="$PRE_FLAGS --relayer-key-file $KEY_FILE"; fi
if [ -n "$RESUME" ]; then
  say "2/7 preflight skipped (--resume)"
elif [ -n "$SKIP_DEPLOY" ]; then
  say "2/7 preflight, exposure check and value plan"
  node "$TOOL" preflight $(net_flags) --wasm "$WASM" $PRE_FLAGS --skip-deploy >"$OUT/preflight.json"
else
  say "2/7 preflight, exposure check and value plan"
  node "$TOOL" preflight $(net_flags) --wasm "$WASM" $PRE_FLAGS >"$OUT/preflight.json"
fi
if [ -n "$DRY_RUN" ]; then
  say "DRY RUN: nothing was sent; the checks and the value plan are in $OUT/preflight.json"
  exit 0
fi

say "    building the journey payload builder"
"$CARGO_BIN" build --quiet --locked --release --manifest-path "$ROOT/contract/integration/Cargo.toml" \
  -p dockside-fixtures --bin dockside-journey-mirror
MIRROR="$ROOT/contract/integration/target/release/dockside-journey-mirror"
[ -x "$MIRROR" ] || MIRROR="$MIRROR.exe"

ESCROW="$DOCKSIDE_ESCROW_ACCOUNT"
RELAYER="$DOCKSIDE_RELAYER_ACCOUNT"
if [ -z "$SKIP_DEPLOY" ]; then
  say "3/7 deploy and initialise $ESCROW in one transaction"
  # One transaction: nobody can initialise the contract between the deploy and `new`. The caps and
  # the pinned token in these arguments cannot be changed afterwards.
  INIT_ARGS=$(node "$TOOL" init-args $(net_flags) $ASSET_FLAGS)
  say "    new $INIT_ARGS"
  if ! node "$TOOL" near-run --near "$NEAR_BIN" --out "$OUT/deploy.txt" -- \
      contract deploy "$ESCROW" use-file "$WASM" \
      with-init-call new json-args "$INIT_ARGS" \
      prepaid-gas '30.0 Tgas' attached-deposit '0 NEAR' \
      network-config "$CLI_NETWORK" sign-with-keychain send </dev/null >/dev/null; then
    say "deploy failed; near-cli-rs output in $OUT/deploy.txt"
    exit 1
  fi
  node "$TOOL" tx-hash --file "$OUT/deploy.txt" >"$OUT/deploy-tx.txt"
  say "    transaction $(cat "$OUT/deploy-tx.txt")"
elif [ -n "$RESUME" ]; then
  say "3/7 deploy skipped (--resume)"
else
  say "3/7 deploy skipped (--skip-deploy)"
fi

say "4/7 verify the on-chain code hash and config"
node "$TOOL" verify-deployment $(net_flags) $ASSET_FLAGS --code-hash "$CODE_HASH" >"$OUT/deployment.json"

# NEP-141: the escrow must be registered with the token to receive it, and the supplier to be
# paid. The escrow account pays the storage deposit (the amounts are in the value plan).
if [ -z "$RESUME" ] && [ "$ASSET" = "usdc" ]; then
  node "$TOOL" registrations --file "$OUT/preflight.json" >"$OUT/registrations.txt"
  N=0
  while read -r WHO DEPOSIT; do
    [ -n "$WHO" ] || continue
    N=$((N + 1))
    say "    register $WHO with $TOKEN ($DEPOSIT yoctoNEAR from $ESCROW)"
    if ! node "$TOOL" near-run --near "$NEAR_BIN" --out "$OUT/storage-deposit-$N.txt" -- \
        contract call-function as-transaction "$TOKEN" storage_deposit \
        json-args "{\"account_id\":\"$WHO\",\"registration_only\":true}" \
        prepaid-gas '30.0 Tgas' attached-deposit "$DEPOSIT yoctoNEAR" \
        sign-as "$ESCROW" network-config "$CLI_NETWORK" sign-with-keychain send </dev/null >/dev/null; then
      say "storage_deposit for $WHO failed; near-cli-rs output in $OUT/storage-deposit-$N.txt"
      exit 1
    fi
  done <"$OUT/registrations.txt"
fi

if [ -z "$KEY_FILE" ]; then
  say "5/7 add a function-call key for $RELAYER restricted to $ESCROW"
  # --signature-scheme: near-cli-rs 0.31 otherwise asks which scheme the new key pair uses.
  if ! node "$TOOL" near-run --near "$NEAR_BIN" --out "$OUT/relayer-key.txt" -- \
      account add-key "$RELAYER" grant-function-call-access --allowance "$ALLOWANCE" \
      --contract-account-id "$ESCROW" --function-names '' \
      autogenerate-new-keypair --signature-scheme ed25519 save-to-legacy-keychain \
      network-config "$CLI_NETWORK" sign-with-keychain send </dev/null >/dev/null; then
    say "adding the relayer key failed; near-cli-rs output in $OUT/relayer-key.txt"
    exit 1
  fi
  KEY_FILE=$(node "$TOOL" relayer-key-file --file "$OUT/relayer-key.txt")
else
  say "5/7 reuse relayer key file $KEY_FILE"
fi
node "$TOOL" verify-relayer-key $(net_flags) --key-file "$KEY_FILE" >"$OUT/relayer.json"

if [ -z "$RESUME" ]; then
  # The non-secret settings --resume reads back (the key seed goes to journey-seed.json, 0600).
  node -e '
const [out, network, rpcUrl, journey, amountYocto, wasm, manifest, relayerKeyFile, contractNetwork, asset, token, tokenDecimals] = process.argv.slice(1);
const params = { schema: "dockside/run-params@1", network, rpcUrl, journey, amountYocto, wasm, manifest, relayerKeyFile,
  contractNetwork, asset, token, tokenDecimals };
require("fs").writeFileSync(`${out}/run-params.json`, `${JSON.stringify(params, null, 2)}\n`);
' "$OUT" "$NETWORK" "$RPC_URL" "$JOURNEY" "$AMOUNT" "$WASM" "$MANIFEST" "$KEY_FILE" "$LABEL" "$ASSET" "$TOKEN" "$TOKEN_DECIMALS"
fi

if [ -n "$RESUME" ]; then say "6/7 $JOURNEY journey (resume)"; else say "6/7 $JOURNEY journey"; fi
set -- --near "$NEAR_BIN" --key-file "$KEY_FILE" --mirror "$MIRROR" --out "$OUT"
if [ -n "$RESUME" ]; then
  set -- "$@" --resume
else
  # shellcheck disable=SC2086 # ASSET_FLAGS holds plain words checked when they were parsed
  set -- "$@" --journey "$JOURNEY" $ASSET_FLAGS
fi
if [ -n "$NO_WAIT" ]; then set -- "$@" --no-wait; fi
if [ -n "$STOP_AFTER" ]; then set -- "$@" --stop-after "$STOP_AFTER"; fi
if [ -n "$PENDING_TX" ]; then set -- "$@" --pending-tx "$PENDING_TX"; fi
STATUS=0
node "$TOOL" journey $(net_flags) "$@" </dev/null >"$OUT/journey-checks.json" || STATUS=$?
if [ "$STATUS" -eq 3 ]; then
  say "PAUSED: the trade is part way on chain; finish it with: scripts/testnet-deploy/run-all --resume $OUT"
  exit 3
fi
if [ "$STATUS" -ne 0 ]; then
  if [ -e "$OUT/journey-seed.json" ]; then say "the trade can be finished later with --resume $OUT"; fi
  exit "$STATUS"
fi

say "7/7 run record"
COMMIT=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)
node -e '
const fs = require("fs");
const [out, commit, network, contractNetwork] = process.argv.slice(1);
const read = (f) => JSON.parse(fs.readFileSync(`${out}/${f}`, "utf8"));
const tx = fs.existsSync(`${out}/deploy-tx.txt`) ? fs.readFileSync(`${out}/deploy-tx.txt`, "utf8").trim() : null;
const j = read("journey.json");
const rec = {
  schema: "dockside/testnet-run@1", network, contractNetwork, asset: j.asset ?? { kind: "near", token: null },
  scriptCommit: commit, artifact: read("artifact.json"),
  deployTx: tx, deployment: read("deployment.json"), relayer: read("relayer.json"),
  journey: { kind: j.journey, ok: j.ok, tradeId: j.tradeId, releaseIntentId: j.releaseIntentId, checks: j.checks,
    transactions: j.steps.filter((s) => s.txHash).map((s) => ({ step: s.step, method: s.method, signer: s.signer,
      txHash: s.txHash, blockTimeMs: s.blockTimeMs })) },
};
fs.writeFileSync(`${out}/run-record.json`, JSON.stringify(rec, null, 2) + "\n");
' "$OUT" "$COMMIT" "$NETWORK" "$LABEL"
if [ "$JOURNEY" = "refund" ]; then OUTCOME=REFUNDED; else OUTCOME=PAID; fi
say "PASS: deployed code hash $CODE_HASH, $JOURNEY journey $OUTCOME; record $OUT/run-record.json"
