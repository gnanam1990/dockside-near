{
  "checks": [
    {
      "name": "the image builds from the Dockerfile",
      "ok": true
    },
    {
      "name": "the image contains no key file, no seed, no .env, no sources and no development tools",
      "ok": true,
      "detail": [
        "==FILES",
        "==KEYS",
        "==DATA",
        "==TOOLS",
        "==END"
      ]
    },
    {
      "name": "without a relayer key from the host the container exits 78 (RELAYER_SIGNER_NOT_PROVISIONED)",
      "ok": true,
      "detail": {
        "exit": 78
      }
    },
    {
      "name": "with a full-access relayer key the container exits 78 (FULL_ACCESS_KEY)",
      "ok": true,
      "detail": {
        "exit": 78,
        "refusal": {
          "event": "worker.refused",
          "code": "CONFIG_INVALID",
          "reason": "FULL_ACCESS_KEY",
          "message": "the relayer key is a full-access key; use a function-call key for the escrow"
        }
      }
    },
    {
      "name": "the container starts and becomes ready",
      "ok": true
    },
    {
      "name": "the API passed the chain preflight against the sandbox escrow (code hash equals the manifest)",
      "ok": true,
      "detail": {
        "chainId": "test-chain-9fOoJ",
        "escrow": "escrow.dockside-root.testnet",
        "codeHash": "7GEti5E6NWcjq8kHj5Gweed5HwggY1cxPD7cfbB65h8N"
      }
    },
    {
      "name": "the worker passed the custody checks: nearcore confirms the function-call key restricted to the escrow",
      "ok": true,
      "detail": {
        "event": "worker.started",
        "network": "near-testnet",
        "chainId": "test-chain-9fOoJ",
        "escrow": "escrow.dockside-root.testnet",
        "codeHash": "7GEti5E6NWcjq8kHj5Gweed5HwggY1cxPD7cfbB65h8N",
        "relayer": "relayer.dockside-root.testnet",
        "relayerPublicKey": "ed25519:2rRt28RUQjMGdkisUSc2ZNxuKR9CLHJzfuqXYwpRwoUk",
        "relayPort": 9034,
        "services": {
          "manifestAttestor": true,
          "deterministicPolicy": true
        }
      }
    },
    {
      "name": "first start created the three service keys on the volume",
      "ok": true,
      "detail": [
        "audit-export",
        "manifest-attestor",
        "deterministic-policy"
      ]
    },
    {
      "name": "GET /healthz answers 200 {status: ok}",
      "ok": true
    },
    {
      "name": "GET /readyz reports the migrated database, near-testnet rules and funded payouts BLOCKED",
      "ok": true,
      "detail": {
        "ready": true,
        "schemaVersion": 10,
        "network": "near-testnet",
        "fundedPayouts": "BLOCKED"
      }
    },
    {
      "name": "GET / serves the web app with the strict content security policy",
      "ok": true
    },
    {
      "name": "every script and stylesheet the page names is served",
      "ok": true,
      "detail": [
        "/assets/index-D2FtvFIz.js",
        "/assets/index-BAW0Nv__.css"
      ]
    },
    {
      "name": "an application route (/sign-in) gets the app shell",
      "ok": true
    },
    {
      "name": "GET /relay/v1/status reaches the worker's relay (relayer and escrow of this deployment)",
      "ok": true,
      "detail": {
        "relayer": "relayer.dockside-root.testnet",
        "contractId": "escrow.dockside-root.testnet",
        "network": "near-testnet",
        "chain": "NEAR_TEST-CHAIN-9FOOJ",
        "note": "function-call key ed25519:2rRt28RUQjMGdkisUSc2ZNxuKR9CLHJzfuqXYwpRwoUk restricted to escrow.dockside-root.testnet; the contract re-verifies every signature in the call."
      }
    },
    {
      "name": "the relay refuses to send the buyer deposit (fund): the answer through the front is its 403",
      "ok": true,
      "detail": {
        "status": 403,
        "error": "FORBIDDEN: this method is not relayed: the party's own wallet sends it (for example fund)"
      }
    },
    {
      "name": "an unauthenticated API call is refused by the API (401)",
      "ok": true
    },
    {
      "name": "every Node.js process of the product runs as the unprivileged user (uid 10001)",
      "ok": true,
      "detail": [
        "287645 10001 node /app/services/hosted/dist/main.js",
        "287925 10001 /usr/local/bin/node /app/services/api/dist/main.js",
        "288851 10001 /usr/local/bin/node /app/packages/authority/signer/isolated-signer.mjs --allow=AUDIT_EXPORT_KEY_ENROLLMENT,AUDIT_EXPORT --seed-file=/data/keys/audit-export.seed",
        "289055 10001 /usr/local/bin/node /app/services/worker/dist/main.js",
        "289071 10001 /usr/local/bin/node /app/packages/authority/signer/isolated-signer.mjs --allow=SERVICE_POP_CHALLENGE,MANIFEST_ATTESTATION --seed-file=/data/keys/manifest-attestor.seed",
        "289086 10001 /usr/local/bin/node /app/packages/authority/signer/isolated-signer.mjs --allow=SERVICE_POP_CHALLENGE,HOLD_SET --seed-file=/data/keys/deterministic-policy.seed"
      ]
    },
    {
      "name": "the relayer key is an owner-only private copy outside the volume; service seeds are on the volume",
      "ok": true,
      "detail": [
        "600 dockside",
        "700 dockside",
        "audit-export.seed",
        "deterministic-policy.seed",
        "manifest-attestor.seed",
        "drwx------",
        "0"
      ]
    },
    {
      "name": "no log line contains the relayer key",
      "ok": true
    },
    {
      "name": "seed-demo enroll: three organisations, the evidence policy, two active services, four invitations",
      "ok": true
    },
    {
      "name": "seed-demo enroll again creates nothing and shows no secret",
      "ok": true
    },
    {
      "name": "a person outside the container accepts an invitation with their own key through the public port",
      "ok": true,
      "detail": {
        "status": 201
      }
    },
    {
      "name": "seed-demo grant gives that person the invited role and reports the others as pending",
      "ok": true,
      "detail": [
        {
          "role": "buyer",
          "capability": "BUYER_APPROVER",
          "invitationId": "inv_6b9dc5b20528557cba4493167b70c2ec",
