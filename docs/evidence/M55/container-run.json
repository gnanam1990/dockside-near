    {
      "name": "that person's own session now carries BUYER_APPROVER (proof-signed request through the front)",
      "ok": true,
      "detail": [
        "BUYER_APPROVER"
      ]
    },
    {
      "name": "docker stop ends the container cleanly (exit 0)",
      "ok": true,
      "detail": {
        "exit": "0"
      }
    },
    {
      "name": "the container restarts on the same volume with the key supplied as a secret variable",
      "ok": true
    },
    {
      "name": "the restart reuses the service keys and the database (no key created, same audit-export key, no migration)",
      "ok": true,
      "detail": {
        "auditExportKeySame": true,
        "migrationsApplied": []
      }
    },
    {
      "name": "no running process of the container has the secret variable in its environment",
      "ok": true,
      "detail": []
    },
    {
      "name": "no log line contains the relayer key after the restart",
      "ok": true
    },
    {
      "name": "after the restart the organisations, the granted person and the services are still there",
      "ok": true
    },
    {
      "name": "the person's session from before the restart still authenticates",
      "ok": true,
      "detail": {
        "status": 200
      }
    }
