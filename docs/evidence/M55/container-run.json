      }
    },
    {
      "name": "the relay refuses to send the buyer deposit (fund): the answer through the front is its 403",
      "ok": true,
      "detail": {
        "status": 403,
        "error": "FORBIDDEN: this method is not relayed: the party's own wallet sends it (for example fund)"
      }
    },
    {
      "name": "an unauthenticated API call is refused by the API (401)",
      "ok": true
    },
    {
      "name": "every Node.js process of the product runs as the unprivileged user (uid 10001)",
      "ok": true,
      "detail": [
        "396753 10001 node /app/services/hosted/dist/main.js",
        "396988 10001 /usr/local/bin/node /app/services/api/dist/main.js",
