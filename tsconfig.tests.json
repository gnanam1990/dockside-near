{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "noPropertyAccessFromIndexSignature": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@dockside/core": [
        "packages/core/src/index.ts"
      ],
      "@dockside/store": [
        "packages/store/src/index.ts"
      ],
      "@dockside/authority": [
        "packages/authority/src/index.ts"
      ],
      "@dockside/api": [
        "services/api/src/app.ts"
      ],
      "@dockside/near": [
        "packages/near/src/index.ts"
      ],
      "@dockside/evidence": [
        "packages/evidence/src/index.ts"
      ],
      "@dockside/release": [
        "packages/release/src/index.ts"
      ],
      "@dockside/journal": [
        "packages/journal/src/index.ts"
      ],
      "@dockside/payout": [
        "packages/payout/src/index.ts"
      ],
      "@dockside/worker": [
        "services/worker/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": false,
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "services/*/test/**/*.ts",
    "vitest.config.ts"
  ]
}
