{
  "name": "@dockside/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dockside control API (M01 authority endpoints, M07 integrated trade/audit surface)",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "bin": {
    "dockside-export-key": "./dist/cli/export-key.js",
    "dockside-verify-export": "./dist/cli/verify-export.js"
  },
  "dependencies": {
    "@dockside/authority": "workspace:*",
    "@dockside/core": "workspace:*",
    "@dockside/evidence": "workspace:*",
    "@dockside/journal": "workspace:*",
    "@dockside/near": "workspace:*",
    "@dockside/payout": "workspace:*",
    "@dockside/release": "workspace:*",
    "@dockside/store": "workspace:*",
    "zod": "4.6.7"
  }
}
