{
  "name": "dockside",
  "private": true,
  "version": "0.1.0",
  "description": "Dockside trade-payment escrow product (monorepo)",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.tests.json && pnpm --filter @dockside/web run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run security",
    "security": "node scripts/secret-scan.mjs",
    "test:sandbox": "node scripts/near-sandbox/run-test.mjs",
    "contract:test": "cargo test --manifest-path contract/Cargo.toml --locked --workspace --exclude dockside-escrow",
    "vectors": "pnpm run build && node scripts/generate-vectors.mjs",
    "clean": "node scripts/clean.mjs",
    "pretest": "pnpm run build && pnpm run contract:build",
    "api": "node services/api/dist/main.js",
    "worker": "node services/worker/dist/main.js",
    "export-key": "node services/api/dist/cli/export-key.js",
    "service-key": "node services/api/dist/cli/service-key.js",
    "verify-export": "node services/api/dist/cli/verify-export.js",
    "verify-receipt": "node services/api/dist/cli/verify-receipt.js",
    "stack": "node --experimental-transform-types --no-warnings --import ./scripts/local-stack/register.mjs scripts/local-stack/stack.ts",
    "contract:build": "node scripts/build-contract.mjs",
    "contract:reproduce": "node scripts/container-reproduce.mjs",
    "contract:sandbox": "node scripts/sandbox/run.mjs",
    "web:build": "pnpm --filter @dockside/web run build",
    "web:e2e": "pnpm --filter @dockside/web run e2e",
    "web:e2e:sandbox": "pnpm --filter @dockside/web run e2e:sandbox",
    "hosted": "node services/hosted/dist/main.js",
    "hosted:verify": "node scripts/hosted/verify-container.mjs",
    "ci:policy": "node scripts/ci/workflow-policy.mjs",
    "ci:local": "node scripts/ci/local-run.mjs",
    "judge": "node scripts/judge/judge.mjs",
    "proof:manifest": "node scripts/proof/build-manifest.mjs",
    "proof:serve": "node scripts/proof/serve.mjs",
    "proof:e2e": "pnpm --filter @dockside/web exec playwright test -c playwright.proof.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "jsqr": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "yaml": "2.9.0"
  }
}
