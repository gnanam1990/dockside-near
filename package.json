{
  "name": "dockside",
  "private": true,
  "version": "0.1.0",
  "description": "Dockside trade-payment escrow product (monorepo)",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run security",
    "security": "node scripts/secret-scan.mjs",
    "contract:test": "cargo test --manifest-path contract/Cargo.toml",
    "vectors": "pnpm run build && node scripts/generate-vectors.mjs",
    "clean": "node scripts/clean.mjs",
    "pretest": "pnpm run build",
    "api": "node services/api/dist/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
