# Build context of the hosted image (Dockerfile). Only what the build needs goes to the engine:
# no local state, no keys, no build output, no contract toolchain.
.git
.github
.data
.dockside-secrets
.env
.env.*
**/node_modules
**/dist
**/*.tsbuildinfo
**/*.log
**/test-results
**/playwright-report
coverage
neardev
contract
fixtures
docs
# site/proof stays: the hosted front serves it (proof page, payment receipts) and the API draws
# the receipt QR code with its encoder (M54).
site/*
!site/proof
